# ==============================
# WhatsApp / Meta
# ==============================
WHATSAPP_TOKEN=           # Access Token מ-Meta Business (Graph API)
PHONE_NUMBER_ID=          # Phone Number ID מ-Meta Business
VERIFY_TOKEN=tori_verify_secret_2024   # אל תשנה אלא אם תשנה גם ב-Meta

# שליחה יזומה (חובה ב-Live mode) — template מאושר ב-Meta Business Manager
WHATSAPP_OPENING_TEMPLATE=tori_first_contact   # שם ה-template מאושר ב-Meta
WHATSAPP_OPENING_TEMPLATE_LANG=he             # שפת ה-template (עברית)
WHATSAPP_OPENING_TEMPLATE_HAS_NAME=true        # true אם גוף ה-template כולל {{1}} לשם

# אופציונלי — template נפרד ל"הודעה ראשונה" מהדשבורד
# WHATSAPP_FIRST_LEAD_TEMPLATE=
# WHATSAPP_FIRST_LEAD_TEMPLATE_LANG=he
# WHATSAPP_FIRST_LEAD_TEMPLATE_HAS_NAME=true

# ==============================
# AI (OpenAI או Gemini)
# ==============================
AI_PROVIDER=openai        # openai | gemini (ברירת מחדל: openai אם יש OPENAI_API_KEY)

# OpenAI / ChatGPT
OPENAI_API_KEY=           # מ-platform.openai.com
OPENAI_MODEL=gpt-4o          # אופציונלי — ברירת מחדל: gpt-4.1-mini
AI_TEMPERATURE=0.5           # 0.4–0.55 לנציג מכירות (ברירת מחדל: 0.5)

# Google Gemini (אם AI_PROVIDER=gemini)
GEMINI_API_KEY=           # מ-Google AI Studio / Vertex
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=256

# ==============================
# Supabase
# ==============================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=          # מ-Project Settings → API → anon / publishable key (לדשבורד)

# ==============================
# Server
# ==============================
PORT=3000
DASHBOARD_PORT=3001

# כתובת ה-API לדשבורד (Railway / מקומי) — לפריסה ב-Vercel
# כתובת שרת הבוט (Railway) — הדשבורד שולח API לכאן. Webhook ב-Meta: {TORI_API_BASE}/webhook
TORI_API_BASE=https://your-app.up.railway.app

# ==============================
# ngrok (npm run tunnel — קורא מ-.env)
# ==============================
NGROK_AUTHTOKEN=          # מ-Dashboard → Your Authtoken
